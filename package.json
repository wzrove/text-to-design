{
  "name": "text-to-design",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "postinstall": "lefthook install",
    "dev": "pnpm --filter text-to-design-ui watch",
    "dev:ui": "pnpm --filter text-to-design-ui dev",
    "build": "pnpm --filter text-to-design-ui build && pnpm --filter text-to-design-mcp build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "release": "pnpm build && node scripts/publish.mjs",
    "chset": "node scripts/new-changeset.mjs",
    "mcp": "pnpm --filter text-to-design-mcp start:dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "catalog:",
    "concurrently": "catalog:",
    "lefthook": "^2.1.12",
    "typescript": "catalog:"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
