{
  "name": "text-to-design",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "scripts": {
    "postinstall": "lefthook install",
    "dev": "pnpm --filter text-to-design-ui watch",
    "dev:ui": "pnpm --filter text-to-design-ui dev",
    "build": "pnpm --filter text-to-design-ui build && pnpm --filter text-to-design-mcp build",
    "typecheck": "pnpm -r run typecheck && tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "pnpm build && node scripts/publish.mjs",
    "chset": "node scripts/new-changeset.mjs",
    "mcp": "pnpm --filter text-to-design-mcp start:dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "catalog:",
    "concurrently": "catalog:",
    "lefthook": "^2.1.14",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
