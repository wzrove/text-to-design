        "$value": "{primitive.color.dot-scale.orange}",
        "$type": "color"
      },
      "star": {
        "$value": "{primitive.color.dot-scale.yellow}",
        "$type": "color"
      },
      "vector": {
        "$value": "{primitive.color.dot-scale.purple}",
        "$type": "color"
      },
      "text": {
        "$value": "{primitive.color.dot-scale.green-bright}",
        "$type": "color"
