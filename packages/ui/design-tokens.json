      "component": {
        "$value": "{primitive.color.dot-scale.pink}",
        "$type": "color"
      },
      "component-set": {
        "$value": "{primitive.color.dot-scale.pink-light}",
        "$type": "color"
      },
      "instance": {
        "$value": "{primitive.color.dot-scale.pink-pale}",
        "$type": "color"
      },
      "boolean-operation": {
