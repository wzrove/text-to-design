        "amber": { "$value": "#f59e0b", "$type": "color" },
        "red": { "$value": "#ef4444", "$type": "color" }
      },
      "dot-scale": {
        "sky": { "$value": "#0ea5e9", "$type": "color" },
        "indigo": { "$value": "#6366f1", "$type": "color" },
        "teal": { "$value": "#14b8a6", "$type": "color" },
        "orange": { "$value": "#f97316", "$type": "color" },
        "orange-light": { "$value": "#fb923c", "$type": "color" },
        "yellow": { "$value": "#eab308", "$type": "color" },
        "purple": { "$value": "#a855f7", "$type": "color" },
        "green-bright": { "$value": "#22c55e", "$type": "color" },
        "pink": { "$value": "#ec4899", "$type": "color" },
        "pink-light": { "$value": "#f472b6", "$type": "color" },
        "pink-pale": { "$value": "#f9a8d4", "$type": "color" },
        "slate": { "$value": "#94a3b8", "$type": "color" },
        "slate-light": { "$value": "#cbd5e1", "$type": "color" }
      },
      "neutral-alpha": {
        "thumb": { "$value": "rgba(128, 128, 128, 0.35)", "$type": "color" },
        "thumb-hover": {
          "$value": "rgba(128, 128, 128, 0.55)",
          "$type": "color"
        }
      }
    }
  },
  "semantic": {
    "color": {
      "primary": {
        "$value": "{primitive.color.brand.green}",
        "$type": "color"
      },
      "accent": { "$value": "{primitive.color.brand.coral}", "$type": "color" },
      "info": {
        "$value": "{primitive.color.status-light.blue}",
        "$type": "color"
      },
      "success": {
        "$value": "{primitive.color.status-light.green}",
        "$type": "color"
      },
      "warning": {
        "$value": "{primitive.color.status-light.amber}",
        "$type": "color"
      },
      "error": {
        "$value": "{primitive.color.status-light.red}",
        "$type": "color"
      }
    }
  },
