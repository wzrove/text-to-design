{
  "name": "text-to-design-ui",
  "version": "0.5.2",
  "type": "module",
  "description": "text-to-design 的 jsDesign 插件包:构建产物含 ui.html + code.js + manifest.json,导入即用",
  "repository": {
    "type": "git",
    "url": "https://github.com/wzrove/text-to-design"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "concurrently \"vite\" \"vite build --mode jsdesign --watch\" \"vite build --mode figma --watch\"",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && vite build && vite build --mode jsdesign && vite build --mode figma",
    "watch": "concurrently \"vite build --watch\" \"vite build --mode jsdesign --watch\"",
    "typecheck": "tsc --noEmit && tsc -p src/code/figma/tsconfig.json"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.137.0",
    "@jsdesigndeveloper/plugin-typings": "^1.0.12",
    "@types/node": "catalog:",
    "autoprefixer": "^10.5.4",
    "concurrently": "catalog:",
    "daisyui": "^4.12.24",
    "postcss": "^8.5.26",
    "solid-js": "^1.9.15",
    "tailwindcss": "^3.4.19",
    "text-to-design-shared": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-plugin-solid": "^2.11.14",
    "zod": "catalog:"
  }
}
