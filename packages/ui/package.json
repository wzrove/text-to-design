{
  "name": "text-to-design-ui",
  "version": "0.13.1",
  "type": "module",
  "description": "text-to-design 的设计工具插件包(jsDesign / Figma / MasterGo):构建产物含 ui.html + code.js + manifest.json,导入即用",
  "repository": {
    "type": "git",
    "url": "https://github.com/wzrove/text-to-design"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "concurrently \"vite build --watch\" \"vite build --mode jsdesign --watch\" \"vite build --mode figma --watch\" \"vite build --mode mastergo --watch\"",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && vite build && vite build --mode jsdesign && vite build --mode figma && vite build --mode mastergo",
    "watch": "concurrently \"vite build --watch\" \"vite build --mode jsdesign --watch\"",
    "typecheck": "tsc --noEmit && tsc -p src/code/figma/tsconfig.json && tsc -p src/code/mastergo/tsconfig.json",
    "dev:ui": "vite --open /ui.html"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.143.0",
    "@jsdesigndeveloper/plugin-typings": "^1.0.12",
    "@mastergo/plugin-typings": "^2.19.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "catalog:",
    "concurrently": "catalog:",
    "daisyui": "^5.8.1",
    "postcss": "^8.5.33",
    "solid-js": "catalog:",
    "tailwindcss": "^4.3.5",
    "text-to-design-shared": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-singlefile": "^2.3.4",
    "zod": "catalog:",
    "@solidjs/web": "catalog:",
    "@solidjs/vite-plugin": "catalog:",
    "@lucide/solid": "catalog:"
  },
  "dependencies": {}
}
