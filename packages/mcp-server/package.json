{
  "name": "text-to-design-mcp",
  "version": "0.6.1",
  "description": "MCP server bridging AI clients to the jsDesign (即时设计) desktop plugin via a local WebSocket",
  "repository": {
    "type": "git",
    "url": "https://github.com/wzrove/text-to-design"
  },
  "type": "module",
  "bin": {
    "text-to-design-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsx scripts/gen-aliases.ts && vite build",
    "prepublishOnly": "pnpm build",
    "start": "node dist/index.js",
    "start:dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "domhandler": "^5.0.3",
    "fuse.js": "^7.5.0",
    "htmlparser2": "^10.0.0",
    "lucide-static": "^1.30.0",
    "ws": "^8.21.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "text-to-design-shared": "workspace:*",
    "tsx": "^4.20.0",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
