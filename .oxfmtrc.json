{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortPackageJson": false,
  "sortImports": {
    "customGroups": [
      {
        "groupName": "url",
        "elementNamePattern": ["http://**", "https://**"]
      }
    ],
    "groups": [
      ["side_effect", "side_effect_style"],
      "url",
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ],
    "internalPattern": ["~/", "@/", "#", "$", "%"],
    "newlinesBetween": false,
    "partitionByNewline": true,
    "sortSideEffects": false
  },
  "overrides": [
    {
      "files": ["**/*.css", "**/*.scss", "**/*.less"],
      "options": {
        "singleQuote": false
      }
    }
  ],
  "ignorePatterns": [
    "**/dist",
    "**/node_modules",
    ".git",
    "**/*.md",
    "**/*.mdx",
    "**/*.yml",
    "**/*.yaml",
    "**/*.html"
  ]
}
